{
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/virse",
      "destination": "/web/api/virse.js"
    },
    {
      "source": "/api/deepseek/chat",
      "destination": "/web/api/deepseek/chat.js"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/web/api/image-download.js"
    },
    {
      "source": "/api/image-download",
      "destination": "/web/api/image-download.js"
    },
    {
      "source": "/api/imgbb",
      "destination": "/web/api/imgbb.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
