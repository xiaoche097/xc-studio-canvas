# Server-only ImgBB key used when Virse's native multipart upload is down.
# Never prefix this with VITE_ and never expose it to browser code.
IMGBB_API_KEY=

# Server-only DeepSeek credential used by /api/deepseek/chat.
# Never prefix the secret itself with VITE_.
DEEPSEEK_API_KEY=

# Safe browser-visible feature flag. The API key remains server-only.
VITE_DEEPSEEK_SERVER_MANAGED=true

# Optional client-side rollout switch. Visual RAG is enabled unless explicitly set to false.
VITE_VISUAL_RAG_ENABLED=true
