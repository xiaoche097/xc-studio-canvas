# Pinterest Developer App Config (For Vercel Deployment)
PINTEREST_CLIENT_ID=your_pinterest_app_id
PINTEREST_CLIENT_SECRET=your_pinterest_app_secret
PINTEREST_REDIRECT_URI=https://your-domain.vercel.app/api/pinterest/callback
# Generate a dedicated random value of at least 32 characters. Never expose it to Vite/client code.
PINTEREST_SESSION_SECRET=replace_with_a_long_random_session_secret

# Gemini API Key
GEMINI_API_KEY=your_gemini_api_key

# DeepSeek is proxied by the serverless route; do not expose this as VITE_*.
DEEPSEEK_API_KEY=your_deepseek_api_key
VITE_DEEPSEEK_SERVER_MANAGED=true
