{
  "framework": "vite",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/virse",
      "destination": "/api/virse.js"
    },
    {
      "source": "/api/deepseek/chat",
      "destination": "/api/deepseek/chat.js"
    },
    {
      "source": "/api/image-proxy",
      "destination": "/api/image-download.js"
    },
    {
      "source": "/api/image-download",
      "destination": "/api/image-download.js"
    },
    {
      "source": "/api/imgbb",
      "destination": "/api/imgbb.js"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
